{
  "name": "web-bridge-mcp",
  "version": "0.1.0",
  "description": "dsh 插件：使用真实浏览器的自动化 MCP server。以无障碍树快照驱动导航、点击、填表、截图与 JS 执行，充当 agent 的眼睛和手。",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "web-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "dsh-plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "test:unit": "node --import tsx --test test/config.test.ts test/util.test.ts test/snapshot-format.test.ts test/walker.test.ts",
    "test:integration": "node --import tsx --test test/integration.test.ts",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.50.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
